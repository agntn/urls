{
  "name": "@agntn/urls",
  "version": "0.1.0",
  "description": "Unified passive URL discovery library for AI agents and CLI",
  "keywords": [
    "agents",
    "cli",
    "omp-extension",
    "osint",
    "pi-extension",
    "pi-package",
    "provider",
    "typescript",
    "unified",
    "url-discovery"
  ],
  "homepage": "https://github.com/agntn/urls#readme",
  "bugs": "https://github.com/agntn/urls/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/urls.git"
  },
  "bin": {
    "urls": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/omp/extensions",
    "packages/pi/extensions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.mts",
      "import": "./dist/providers/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "fmt": "pnpm build && oxlint . --fix && oxfmt .",
    "lint": "pnpm build && oxlint . && oxfmt --check .",
    "typecheck": "tsc --noEmit --skipLibCheck && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:cli": "pnpm build && node test/eval-cli.mjs",
    "test:mcp": "pnpm build && node test/eval-mcp.mjs",
    "test:packed": "node test/eval-packed.mjs",
    "prepack": "pnpm run build",
    "release": "pnpm test && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@oh-my-pi/omptype": "18.0.0",
    "@oh-my-pi/pi-coding-agent": "18.0.0",
    "@types/node": "26.2.0",
    "ai": "7.0.112",
    "changelogen": "0.6.2",
    "obuild": "0.4.40",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <1",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": ">=7.0.0",
    "typebox": ">=1.3.14 <2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.3.0",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/urls.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/urls.ts"
    ]
  }
}
